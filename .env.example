# Supabase project → Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Use the PUBLISHABLE key (sb_publishable_...) or the legacy "anon" key.
# Never put the secret / service_role key here — NEXT_PUBLIC_ values are sent to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx
